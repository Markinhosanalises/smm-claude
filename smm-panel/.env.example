# Vercel: Root Directory = smm-panel; Node.js 22 ou superior; HTTPS obrigatório.
FIREBASE_URL=https://SEU-PROJETO-default-rtdb.firebaseio.com
# JSON completo de uma conta de serviço com acesso ao Realtime Database.
# Guarde apenas nas variáveis protegidas do servidor; nunca no GitHub/public.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"SEU-PROJETO","client_email":"...","private_key":"..."}
APP_URL=https://seu-dominio.com
# Gere valores aleatórios fortes, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PIN=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_64_CARACTERES
CRON_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO
MP_WEBHOOK_SECRET=ASSINATURA_SECRETA_DA_APLICACAO_MERCADO_PAGO
# Opcional: tem preferência sobre o token cadastrado no admin.
MP_ACCESS_TOKEN=
# Somente hosts HTTPS explicitamente autorizados. Sem esquemas ou caminhos.
FORNECEDOR_ALLOWED_HOSTS=measmm.com
